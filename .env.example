# Server-side URL the Next.js server uses to reach the Laravel API.
# Inside Docker Compose this is the backend service name; locally http://localhost:8000.
API_URL=http://localhost:8000

# Send the session cookie only over HTTPS. Set to true behind TLS in production.
SESSION_COOKIE_SECURE=false

# Optional: map tiles for GPS tracking / route planning. Leave empty until a provider is configured.
NEXT_PUBLIC_MAP_PROVIDER=
